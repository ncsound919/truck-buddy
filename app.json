{
  "expo": {
    "name": "truckbuddy",
    "slug": "truckbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "truckbuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.truckbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "package": "com.truckbuddy.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Truck Buddy uses the camera to scan bills of lading and delivery receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Truck Buddy uses your location to detect when you arrive at a stop."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Truck Buddy reads your contacts so you can text, call, or email a stop contact in one tap."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://bxjtmcumkffcbzuhusxn.supabase.co",
      "supabaseAnonKey": "sb_publishable_TPLtkfxtvxXRWFY_K7FMuw_CQ58kVcI",
      "dispatchFunctionPath": "/functions/v1/dispatch-send"
    }
  }
}
